# InovaCortex local environment template
# Copy this file to .env.local or .env and fill with values.

# Core infrastructure
DATABASE_URL="postgresql://user:password@localhost:5432/inovacortex"
DIRECT_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# App encryption for session/cookie/secret data
APP_ENCRYPTION_KEY="your-64-char-random-base64-string"

# Optional envs
# API and 3rd-party keys
# OPENAI_API_KEY=""
# CRON_SECRET="replace-with-a-random-secret-for-cron-jobs"
# STRIPE_SECRET_KEY=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
