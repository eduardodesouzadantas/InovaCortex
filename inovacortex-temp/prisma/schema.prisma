// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ─── V9: Multi-Tenant Core Models ─────────────────────────────────────────────

model Organization {
  id                     String @id @default(uuid())
  name                   String
  slug                   String @unique
  plan                   String @default("free") // free | growth | enterprise
  maxAssessmentsPerMonth Int    @default(50)
  maxUsers               Int    @default(5)
  industry               String @default("Services") // Added for V30/V31 benchmarks

  // V10: Stripe Billing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String    @default("none") // active | past_due | canceled | trialing | none
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  users          User[]
  assessments    Assessment[]
  usageEvents    UsageEvent[]
  usageSnapshots MonthlyUsageSnapshot[]
  whatsappUsers  WhatsAppUser[]
  salesReps      SalesRep[]
  commissionRules CommissionRule[]
  
  // V36 WhatsApp CRM models
  contacts              Contact[]
  whatsappConversations WhatsAppConversation[]
  whatsappTemplates     WhatsAppTemplate[]
  whatsappCampaigns     WhatsAppCampaign[]

  @@map("organizations")
}

// ─── V10: Usage Metering ──────────────────────────────────────────────────────

model UsageEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String // assessmentCreated | dossierGenerated | pdfGenerated | proposalGenerated | presalesGenerated
  quantity       Int          @default(1)
  metadata       String? // JSON string: { assessmentId?, slug?, ... }
  createdAt      DateTime     @default(now())

  @@index([organizationId, type, createdAt])
  @@map("usage_events")
}

model MonthlyUsageSnapshot {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  month              String // YYYY-MM
  assessmentsCount   Int          @default(0)
  pdfCount           Int          @default(0)
  proposalCount      Int          @default(0)
  aiGenerationsCount Int          @default(0)
  dossierCount       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, month])
  @@map("monthly_usage_snapshots")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  role           String       @default("admin") // owner | admin | closer | viewer
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  salesReps      SalesRep[]
  managedAssignments LeadAssignment[]
  assignedWhatsAppConversations WhatsAppConversation[]

  @@map("users")
}

// ─── Core Assessment Model ─────────────────────────────────────────────────────

model Assessment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // V9: Multi-tenant isolation
  organizationId String       @default("default-org-id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Passo 1: Dados
  name            String
  email           String
  company         String
  role            String
  phone           String? // Capturado para disparo de WhatsApp
  whatsappConsent Boolean @default(false) // Consentimento LGPD

  // Passo 2: Contexto
  segment   String
  teamSize  String
  volumeDay String
  channels  String // Array of strings stored as JSON string

  // Passo 3: Stack
  stack String // CRM, ERP, API, Make, Zapier, etc stored as JSON string

  // Passo 4: Dores
  pains   String // Array of strings stored as JSON string
  urgency String
  goal    String

  // Auto-Classification Scoring
  scoreTotal          Int
  scoreBreakdown      String // Object with A, B, C, D, E scores stored as JSON string
  classification      String // "Alta prioridade" | "Boa oportunidade" | "Exploratória"
  recommendedMissions String // Array of strings stored as JSON string

  // CRM (Missão V4)
  status        String  @default("Novo") // Novo, Qualificado, Contatado, Agendado, Fechado, Perdido
  internalNotes String? // Rascunhos livres

  artifactReport    ArtifactReport?
  messageLogs       MessageLog[]
  auditEvents       AuditEvent[]
  preSalesArtifacts PreSalesArtifact[]
  roiProjection     RoiProjection?
  proposals         Proposal[]
  assignments       LeadAssignment[]

  @@map("assessments")
}

// ─── Derived Models (all scoped by organizationId via Assessment) ──────────────

model Proposal {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  version      Int        @default(1)
  publicSlug   String     @unique

  // V9: Direct org scoping for standalone queries
  organizationId String @default("default-org-id")

  // Structured JSON fields (SQLite stores as TEXT)
  modules          String // JSON: ProposalModule[]
  pricingEstimate  String // JSON: { min, max, currency, basis }
  roiSnapshot      String // JSON: ROI data at generation time
  presalesSnapshot String // JSON: PreSales artifact snapshot (nullable)

  status      String  @default("draft") // draft | sent | viewed | accepted | rejected
  customNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proposals")
}

model RoiProjection {
  id           String     @id @default(uuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id])

  // Base projection
  operationalSavingsEstimate Float
  revenueIncreaseEstimate    Float
  monthlyHoursRecovered      Float
  estimatedPaybackMonths     Float
  confidenceLevel            String // "Baixa" | "Média" | "Alta"

  // Manual override (admin simulator)
  manualOverride Boolean @default(false)
  avgHourlyCost  Float?
  avgTicket      Float?
  conversionRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roi_projections")
}

model ArtifactReport {
  id           String     @id @default(uuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  createdAt    DateTime   @default(now())

  contentJson String
  publicSlug  String @unique
  version     Int    @default(1)

  @@map("artifact_reports")
}

model MessageLog {
  id              String     @id @default(uuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id])
  provider        String // "whatsapp_meta"
  status          String // "sent", "delivered", "read", "failed"
  payloadRedacted String
  createdAt       DateTime   @default(now())

  @@map("message_logs")
}

model AuditEvent {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  action       String // Includes: benchmarkGenerated | benchmarkViewed | benchmarkExported
  details      String?

  // V9: Direct org scoping
  organizationId String @default("default-org-id")

  createdAt DateTime @default(now())

  @@map("audit_events")
}

model PreSalesArtifact {
  id                  String     @id @default(uuid())
  assessmentId        String
  assessment          Assessment @relation(fields: [assessmentId], references: [id])
  version             Int        @default(1)
  executiveSummary    String
  diagnosticQuestions String
  initialArchitecture String
  createdAt           DateTime   @default(now())

  @@map("presales_artifacts")
}

model SystemSetting {
  id             String   @id @default(uuid())
  key            String
  organizationId String   @default("default-org-id")
  value          String // Stored encrypted via AES-256-GCM
  updatedAt      DateTime @updatedAt

  @@unique([key, organizationId])
  @@map("system_settings")
}

model AIInvocation {
  id               String   @id @default(uuid())
  assessmentId     String
  organizationId   String   @default("default-org-id")
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  estimatedCostUsd Float    @default(0)
  latencyMs        Int
  status           String
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@map("ai_invocations")
}

// ─── V11: Observability Alerts ────────────────────────────────────────────────

model AlertEvent {
  id             String    @id @default(uuid())
  organizationId String    @default("default-org-id")
  type           String // webhookFailure | aiFailureRate | usageThreshold | limitExceeded
  severity       String    @default("warning") // info | warning | critical
  message        String
  metadata       String? // JSON
  resolved       Boolean   @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, type, resolved])
  @@map("alert_events")
}

// ─── V12: Execution Engine ─────────────────────────────────────────────────────

model ClientWorkspace {
  id                   String    @id @default(uuid())
  organizationId       String
  assessmentId         String
  proposalId           String    @unique
  /// provisioning_hold | provisioning | active | paused | completed
  status               String    @default("provisioning")
  modulesEnabled       String // JSON: string[] of enabled module IDs
  goLiveAt             DateTime?
  /// Magic token for client portal — sent via onboarding pack URL
  workspacePublicToken String    @unique @default(uuid())
  /// If true, the org explicitly allows real name in published proof assets
  allowPublicName      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now())

  tasks     ImplementationTask[]
  checklist IntegrationChecklistItem[]
  uploads   WorkspaceUpload[]
  comments  WorkspaceComment[]

  @@index([organizationId, status])
  @@map("client_workspaces")
}

model ImplementationTask {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   ClientWorkspace @relation(fields: [workspaceId], references: [id])
  title       String
  description String
  ownerRole   String          @default("admin") // owner | admin | closer
  status      String          @default("todo") // todo | doing | blocked | done
  phase       String          @default("setup") // setup | development | launch | handoff
  orderIndex  Int             @default(0)
  dueAt       DateTime?
  doneAt      DateTime?
  createdAt   DateTime        @default(now())

  comments WorkspaceComment[]

  @@index([workspaceId, status])
  @@map("implementation_tasks")
}

model IntegrationChecklistItem {
  id          String          @id @default(uuid())
  workspaceId String
  workspace   ClientWorkspace @relation(fields: [workspaceId], references: [id])
  system      String // WhatsApp, Instagram, CRM, ERP, Make, Zapier, etc
  item        String // "Gerar token", "Criar webhook", "Mapear campos"
  status      String          @default("pending") // pending | provided | verified
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([workspaceId, system])
  @@map("integration_checklist_items")
}

// ─── V19: Client Portal Uploads + Comments ────────────────────────────────────

model WorkspaceUpload {
  id          String          @id @default(uuid())
  orgId       String
  workspaceId String
  workspace   ClientWorkspace @relation(fields: [workspaceId], references: [id])
  /// logo | brand | copy | credentials | other
  type        String          @default("other")
  filename    String
  url         String
  sizeBytes   Int?
  createdAt   DateTime        @default(now())

  @@index([workspaceId])
  @@index([orgId, type])
  @@map("workspace_uploads")
}

model WorkspaceComment {
  id          String              @id @default(uuid())
  orgId       String
  workspaceId String
  workspace   ClientWorkspace     @relation(fields: [workspaceId], references: [id])
  taskId      String?
  task        ImplementationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// client | team
  authorType  String              @default("client")
  body        String
  createdAt   DateTime            @default(now())

  @@index([workspaceId])
  @@index([taskId])
  @@map("workspace_comments")
}

// ─── R2: Content Engine ────────────────────────────────────────────────────────

model ContentArtifact {
  id             String  @id @default(uuid())
  organizationId String
  assessmentId   String? // Optional link to source lead
  proposalId     String? // Optional link to source proposal

  type    String // linkedin | instagram | case_breakdown | authority_thread | video_script
  version Int    @default(1)
  status  String @default("draft") // draft | reviewed | approved | scheduled | posted

  title    String
  body     String // Main content text
  hook     String? // Opening hook (especially for social)
  cta      String? // Call-to-action at the end
  hashtags String? // JSON: string[] — for social posts
  metadata String? // JSON: any structured extra data (ROI numbers used, etc.)

  // Review & approval trail
  reviewedBy   String?
  reviewedAt   DateTime?
  approvedBy   String?
  approvedAt   DateTime?
  scheduledFor DateTime?
  postedAt     DateTime?

  // Source data snapshot (for auditability)
  roiSnapshot   String? // JSON: ROI numbers at generation time
  sourceInsight String? // The real insight that drove this piece

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([organizationId, type, status])
  @@index([organizationId, createdAt])
  @@map("content_artifacts")
}

// ─── R3: Funnel Automation ────────────────────────────────────────────────────

model LeadSequence {
  id             String         @id @default(uuid())
  organizationId String
  assessmentId   String         @unique
  phone          String
  scoreTier      String // hot | warm | cold
  status         String         @default("active") // active | paused | completed | opted_out
  currentStage   String         @default("post_click")
  lastMessageAt  DateTime?
  nextAllowedAt  DateTime?
  convertedAt    DateTime?
  optedOutAt     DateTime?
  steps          SequenceStep[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())

  @@index([organizationId, status, currentStage])
  @@index([organizationId, nextAllowedAt])
  @@map("lead_sequences")
}

model SequenceStep {
  id          String       @id @default(uuid())
  sequenceId  String
  sequence    LeadSequence @relation(fields: [sequenceId], references: [id])
  stage       String
  channel     String       @default("whatsapp")
  templateKey String
  messageBody String
  scoreTier   String
  status      String       @default("pending") // pending | sent | delivered | read | replied | bounced
  sentAt      DateTime?
  deliveredAt DateTime?
  repliedAt   DateTime?
  waMessageId String?
  createdAt   DateTime     @default(now())

  @@index([sequenceId, stage])
  @@index([sequenceId, status])
  @@map("sequence_steps")
}

// ─── R4: Authority Amplifier ──────────────────────────────────────────────────

model AuthorityAsset {
  id             String @id @default(uuid())
  organizationId String

  // Source links (all optional — can be generated from partial data)
  workspaceId  String? // Link to completed workspace
  assessmentId String?
  proposalId   String?

  // Asset classification
  type    String // case_study | linkedin_post | article | video_script | stat_card
  status  String @default("internal") // internal | anonymized | approved | published
  version Int    @default(1)

  // Core content
  title       String
  headline    String // 1-sentence impact statement
  body        String // Full narrative content
  keyMetrics  String // JSON: { savings, hoursRecovered, paybackMonths, conversionRate }
  modules     String? // JSON: string[] — which modules were deployed
  sector      String? // Anonymized sector label (e.g. "Clínica Médica", "Imobiliária")
  companySize String? // "5-20 funcionários", "20-80 funcionários", etc.

  // Anonymization
  anonLevel    String  @default("full") // none | sector_only | size_only | full
  originalData String? // JSON: raw metrics before anonymization (internal only)

  // Approval trail
  approvedBy   String?
  approvedAt   DateTime?
  publishedAt  DateTime?
  publishedUrl String? // External URL where published (LinkedIn, blog, etc.)

  // Usage tracking (how many proposals referenced this asset)
  usageCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([organizationId, type, status])
  @@index([organizationId, status])
  @@map("authority_assets")
}

model ProofStatistic {
  id             String @id @default(uuid())
  organizationId String

  // The stat itself
  label      String // "Taxa média de payback"
  value      String // "4.2 meses"
  unit       String? // "meses", "%", "R$", "horas"
  sampleSize Int     @default(1) // How many cases feed this stat
  sector     String? // Optional filter

  // Lifecycle
  isPublic      Boolean  @default(false)
  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([organizationId, isPublic])
  @@map("proof_statistics")
}

// ─── V15: Multi-Agent Orchestration ("Brain") ──────────────────────────────────

model AgentRun {
  id             String @id @default(uuid())
  organizationId String
  agentName      String
  status         String // queued | running | succeeded | failed | canceled

  inputHash  String // Idempotency key
  inputJson  String // JSON string
  outputJson String? // JSON string

  costUsd   Float @default(0)
  tokensIn  Int   @default(0)
  tokensOut Int   @default(0)

  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  relatedEntityType String? // assessment | proposal | content | workspace | etc
  relatedEntityId   String?

  @@index([organizationId, agentName, status])
  @@index([inputHash])
  @@map("agent_runs")
}

model ActionQueue {
  id             String @id @default(uuid())
  organizationId String
  type           String // send_whatsapp | publish_content | generate_proposal | etc
  payloadJson    String // Specific action payload
  priority       String @default("medium") // critical | high | medium | low
  status         String @default("pending") // pending | review_required | approved | executed | rejected | expired

  approvalRequired Boolean   @default(false)
  approvedBy       String?
  approvedAt       DateTime?
  executedAt       DateTime?
  reason           String? // explanation of why this action was rejected or failed

  relatedEntityType String?
  relatedEntityId   String?

  // Lock and Lease mechanics for concurrent processor
  lockedByRunId String?
  lockedUntil   DateTime?
  attempts      Int       @default(0)
  nextRetryAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, priority])
  @@index([lockedUntil])
  @@map("action_queue")
}

model PolicyDecision {
  id             String @id @default(uuid())
  organizationId String
  actionQueueId  String
  policyName     String
  decision       String // allow | block | review
  explanation    String

  createdAt DateTime @default(now())

  @@index([organizationId, actionQueueId])
  @@map("policy_decisions")
}

// ─── V16.1: Meeting Intelligence Service ───────────────────────────────────────

model MeetingSession {
  id             String   @id @default(uuid())
  organizationId String
  assessmentId   String?
  leadEmail      String
  startAt        DateTime
  endAt          DateTime
  timezone       String
  status         String // scheduled | completed | canceled

  revenueScore     Float  @default(0)
  closeProbability Float  @default(0)
  priorityTier     String @default("warm") // hot | warm | cold

  meetingUrl      String?
  externalEventId String?
  googleEventId   String?

  // V17: Calibration Engine fields
  adjustedProbability Float?
  expectedRevenue     Float?
  confidenceScore     Float?

  // V17 P2: Strategy Engine output (persisted by brainCycle)
  followUpTone      String? // direct | consultative | educational
  urgencyLevel      Int? // 1-5
  proposalStructure String? // compact | modular | aggressive
  recommendedCTA    String? // schedule | reply_yes | review_proposal | send_doc | soft_nurture

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  performances      MeetingPerformance[]
  proposalDraftLink ProposalDraftLink?

  @@index([organizationId, status])
  @@index([leadEmail])
  @@index([organizationId, adjustedProbability])
  @@index([organizationId, expectedRevenue])
  @@index([organizationId, urgencyLevel])
  @@map("meeting_sessions")
}

// ─── V17 P3: Auto-Draft Proposal Gating ───────────────────────────────────────

model ProposalDraftLink {
  id               String   @id @default(uuid())
  orgId            String
  meetingSessionId String   @unique
  proposalId       String
  createdAt        DateTime @default(now())

  session MeetingSession @relation(fields: [meetingSessionId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("proposal_draft_links")
}

model ReviewRequest {
  id             String    @id @default(uuid())
  orgId          String
  entityType     String // proposal | etc
  entityId       String
  status         String    @default("pending") // pending | approved | rejected
  reviewerUserId String?
  notes          String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([orgId, status])
  @@index([orgId, entityType, entityId])
  @@map("review_requests")
}

model MeetingPerformance {
  id             String  @id @default(uuid())
  organizationId String
  sessionId      String
  outcome        String // won | lost | no_show | pending
  closedValue    Float   @default(0)
  notes          String? @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session MeetingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sessionId])
  @@map("meeting_performances")
}

// ─── V16.2: Calendar Integration ───────────────────────────────────────────────

model CalendarIntegration {
  id                    String    @id @default(uuid())
  organizationId        String    @unique
  provider              String    @default("google") // google | ical (future)
  status                String    @default("disconnected") // connected | disconnected | error
  calendarId            String    @default("primary")
  ownerEmail            String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiryAt              DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, provider])
  @@map("calendar_integrations")
}

// ─── V16.3: WhatsApp Message Log ─────────────────────────────────────────────

model WhatsAppMessageLog {
  id                String    @id @default(uuid())
  organizationId    String
  actionQueueItemId String    @unique // dedupe: 1 log per queue item
  toPhone           String
  templateKey       String
  waMessageId       String? // returned by Meta API
  status            String    @default("queued") // queued | sent | failed
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([organizationId, status])
  @@map("whatsapp_message_logs")
}

// ─── V16.3-P2: Org Owner Notification Channel ────────────────────────────────

model OrgNotificationChannel {
  id             String  @id @default(uuid())
  organizationId String  @unique
  ownerWhatsApp  String? // E.164 phone of the owner
  ownerEmail     String?
  preferChannel  String  @default("whatsapp") // whatsapp | email

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("org_notification_channels")
}

// ─── V17 P3/P3: Send-Window Optimization ─────────────────────────────────────

model SendWindowStat {
  id         String   @id @default(uuid())
  orgId      String
  hourBucket Int // 0-23 (local BR hour, UTC-3)
  sentCount  Int      @default(0)
  wonCount   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([orgId, hourBucket])
  @@index([orgId])
  @@map("send_window_stats")
}

// ─── V20.1: AgentOps Foundation ──────────────────────────────────────────────

/// Per-org daily token budget with hard-stop enforcement.
model AgentBudget {
  id               String   @id @default(uuid())
  orgId            String   @unique
  dailyTokenLimit  Int      @default(20000)
  dailyTokenUsed   Int      @default(0)
  dailyCostUsdUsed Float    @default(0.0)
  /// UTC datetime when dailyTokenUsed resets (midnight UTC-3)
  resetAt          DateTime @default(now())
  /// If true: reject agent calls when budget exceeded. If false: allow with a warning.
  hardStop         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("agent_budgets")
}

/// LLM output cache — keyed by (orgId, keyHash) to skip redundant generations.
model AgentCache {
  id         String   @id @default(uuid())
  orgId      String
  keyHash    String // sha256 of (agentName+model+normalised input)
  agentName  String
  model      String
  inputHash  String // raw sha256 of input JSON (for debugging)
  outputJson String // full JSON-serialised result
  tokensUsed Int      @default(0)
  costUsd    Float    @default(0.0)
  createdAt  DateTime @default(now())

  @@unique([orgId, keyHash])
  @@index([orgId, agentName])
  @@index([createdAt])
  @@map("agent_cache")
}

// ─── V18: Contract + Billing Autopilot ───────────────────────────────────────

model Contract {
  id          String    @id @default(uuid())
  orgId       String
  proposalId  String    @unique
  version     Int       @default(1)
  /// draft | sent | signed | canceled
  status      String    @default("draft")
  publicSlug  String    @unique
  htmlBody    String // full rendered HTML
  pdfUrl      String?
  signedName  String?
  signedEmail String?
  signedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId])
  @@index([orgId, status])
  @@map("contracts")
}

model BillingRecord {
  id                      String    @id @default(uuid())
  orgId                   String
  proposalId              String    @unique
  stripeCheckoutSessionId String?
  stripeInvoiceId         String?
  amountCents             Int
  currency                String    @default("BRL")
  /// pending | paid | failed | refunded | stub_paid
  status                  String    @default("pending")
  checkoutUrl             String?
  paidAt                  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([orgId])
  @@index([orgId, status])
  @@index([stripeCheckoutSessionId])
  @@map("billing_records")
}

// ─── V20.1: Marketing Planner Agent ─────────────────────────────────────────

/// One day entry in a 30-day editorial calendar generated by the Marketing Planner Agent.
model MarketingPlan {
  id           String    @id @default(uuid())
  orgId        String
  day          Int // 1-30
  /// linkedin | instagram
  platform     String
  /// authority | case | insight | demonstration | offer | myth_break
  postType     String
  topic        String
  hook         String
  cta          String
  priority     Int       @default(2)
  /// Stored as JSON: { text, hashtags[], shortTitle, postingPack? }
  contentJson  String?
  /// draft | reviewed | approved | scheduled | posted | ready_to_post
  status       String    @default("draft")
  scheduledFor DateTime?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())

  @@unique([orgId, day])
  @@index([orgId, platform])
  @@index([orgId, status])
  @@map("marketing_plans")
}

// ─── V20.1: Publisher Agent ──────────────────────────────────────────────────

/// Per-org social media integration tokens (encrypted at rest).
model SocialIntegration {
  id                     String   @id @default(uuid())
  orgId                  String   @unique
  /// connected | disconnected
  linkedinStatus         String   @default("disconnected")
  /// connected | disconnected
  instagramStatus        String   @default("disconnected")
  metaPageId             String?
  /// AES-256-GCM encrypted — use APP_ENCRYPTION_KEY
  metaAccessTokenEnc     String?
  linkedinAccessTokenEnc String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("social_integrations")
}

/// Audit log of every publish attempt per MarketingPlan entry.
model PublicationLog {
  id              String    @id @default(uuid())
  orgId           String
  marketingPlanId String    @unique
  platform        String
  /// ready | scheduled | posted | failed | stub
  status          String    @default("ready")
  externalPostId  String?
  scheduledFor    DateTime?
  postedAt        DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([orgId, status])
  @@index([orgId, platform])
  @@map("publication_logs")
}

// ─── V21: Repurpose Engine ────────────────────────────────────────────────────

/// 5-format repurpose artifact generated from a MarketingPlan entry.
model RepurposeArtifact {
  id                    String   @id @default(uuid())
  orgId                 String
  sourceMarketingPlanId String
  version               Int      @default(1)
  /// draft | reviewed | approved | scheduled | published
  status                String   @default("draft")
  /// JSON: { linkedin_v2, carousel, thread, video, email }
  formatsJson           String
  createdAt             DateTime @default(now())

  @@index([orgId, sourceMarketingPlanId])
  @@index([orgId, status])
  @@map("repurpose_artifacts")
}

/// Execution log for each repurpose call (LLM or stub).
model RepurposeRun {
  id                    String   @id @default(uuid())
  orgId                 String
  sourceMarketingPlanId String
  tokensUsed            Int      @default(0)
  costUsd               Float    @default(0.0)
  /// success | stub | failed
  status                String   @default("success")
  error                 String?
  createdAt             DateTime @default(now())

  @@index([orgId])
  @@map("repurpose_runs")
}

// ─── V21: Authority Flywheel ──────────────────────────────────────────────────

/// Proof asset generated from a completed ClientWorkspace.
/// One of: case_study | linkedin_case | stat_card
model ProofAsset {
  id           String   @id @default(uuid())
  orgId        String
  workspaceId  String
  /// case_study | linkedin_case | stat_card
  type         String
  /// full | sector_only | size_only | none
  anonLevel    String   @default("full")
  /// draft | reviewed | approved | published
  status       String   @default("draft")
  title        String
  body         String
  /// JSON: { ROI, payback, horas, modulos, diasGoLive }
  metricsJson  String
  publishedUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, workspaceId, type, anonLevel])
  @@index([orgId, status])
  @@index([orgId, type])
  @@map("proof_assets")
}

/// Aggregated proof stats snapshot per org (updated on every new ProofAsset approval).
model ProofStatSnapshot {
  id                String   @id @default(uuid())
  orgId             String   @unique
  totalCases        Int      @default(0)
  avgPaybackMonths  Float    @default(0)
  avgMonthlyEconomy Float    @default(0)
  avgMonthlyRevenue Float    @default(0)
  avgHoursSaved     Float    @default(0)
  updatedAt         DateTime @updatedAt

  @@map("proof_stat_snapshots")
}

// ─── V21: Deal Flow Engine ─────────────────────────────────────────────────────

/// Executive-level deal packet per assessment — hot lead autopilot.
model DealPacket {
  id               String   @id @default(uuid())
  orgId            String
  assessmentId     String
  proposalId       String?
  /// draft | sent | viewed | meeting_booked | won | lost
  status           String   @default("draft")
  /// hot | warm | cold
  tier             String   @default("cold")
  /// HTML of the Executive One-Pager (public-safe, no blueprint)
  execOnePagerHtml String
  /// Short unique slug for the public URL
  execSlug         String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  signals DealSignal[]

  @@index([orgId, status])
  @@index([orgId, tier])
  @@index([orgId, assessmentId])
  @@map("deal_packets")
}

/// Engagement signal for a DealPacket (views, CTAs, replies, no-responses).
model DealSignal {
  id           String      @id @default(uuid())
  orgId        String
  assessmentId String
  dealPacketId String?
  dealPacket   DealPacket? @relation(fields: [dealPacketId], references: [id])
  /// dossier_viewed | proposal_viewed | proposal_accepted | meeting_scheduled | whatsapp_replied | no_response_72h | whatsapp_sent
  type         String
  metadataJson String?
  createdAt    DateTime    @default(now())

  @@index([orgId, assessmentId, createdAt])
  @@index([orgId, type])
  @@map("deal_signals")
}

// ─── V21: LinkedIn Outbound Engine ────────────────────────────────────────────

/// A LinkedIn prospect in the outbound pipeline.
model Prospect {
  id               String   @id @default(uuid())
  orgId            String
  fullName         String
  title            String
  company          String
  industry         String
  /// 1-10 | 11-50 | 51-200 | 201-1000 | 1000+
  companySize      String
  location         String   @default("")
  linkedinUrl      String
  estimatedRevenue String?
  discoverySource  String   @default("ai_agent")
  email            String?
  phone            String?
  /// new | connected | replied | meeting | lost | do_not_contact
  status           String   @default("new")
  /// manual | import | scrape_stub
  source           String   @default("manual")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sequences OutboundSequence[]
  messages  OutboundMessage[]

  @@unique([orgId, linkedinUrl])
  @@index([orgId, status, updatedAt])
  @@map("prospects")
}

/// Active outbound sequence for a prospect (one active per prospect).
model OutboundSequence {
  id         String   @id @default(uuid())
  orgId      String
  prospectId String   @unique
  prospect   Prospect @relation(fields: [prospectId], references: [id])
  /// connect | dm1 | dm2 | dm3 | close | done
  stage      String   @default("connect")
  nextAt     DateTime
  paused     Boolean  @default(false)
  /// sent | skipped | replied | bounced | unknown
  lastResult String   @default("unknown")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages OutboundMessage[]

  @@index([orgId, paused, nextAt])
  @@map("outbound_sequences")
}

/// Individual message attempt in an outbound sequence.
model OutboundMessage {
  id          String           @id @default(uuid())
  orgId       String
  prospectId  String
  prospect    Prospect         @relation(fields: [prospectId], references: [id])
  sequenceId  String
  sequence    OutboundSequence @relation(fields: [sequenceId], references: [id])
  stage       String
  channel     String           @default("linkedin")
  templateKey String
  body        String
  /// queued | sent | failed | stub
  status      String           @default("stub")
  sentAt      DateTime?
  error       String?
  createdAt   DateTime         @default(now())

  @@index([orgId, prospectId, createdAt])
  @@index([orgId, status])
  @@map("outbound_messages")
}

// ─── V22.1: Profit Leak Detector ─────────────────────────────────────────────

/// A detected profit leak instance — one row per org+kind+day (idempotent).
model ProfitLeak {
  id                 String   @id @default(uuid())
  orgId              String
  /// lead_no_response | stale_followup | no_show | proposal_stale | pipeline_stall | low_reply_rate
  kind               String
  /// low | medium | high | critical
  severity           String
  title              String
  description        String
  estimatedLossCents Int
  /// JSON: contextual evidence (counts, ids, samples)
  evidenceJson       String
  /// open | acknowledged | resolved
  status             String   @default("open")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orgId, kind, severity, status, createdAt])
  @@map("profit_leaks")
}

/// Aggregated snapshot per org per time window — upserted on each scan.
model ProfitLeakSnapshot {
  id             String   @id @default(uuid())
  orgId          String
  /// today | 7d | 30d
  window         String
  totalLossCents Int
  topLeakKind    String?
  /// JSON: { kind -> lossCents }
  breakdownJson  String
  createdAt      DateTime @default(now())

  @@unique([orgId, window])
  @@map("profit_leak_snapshots")
}

// ─── V24: Executive Pack ──────────────────────────────────────────────────────

/// A generated executive pack (one per org per run, stored forever for history).
model ExecPack {
  id          String   @id @default(uuid())
  orgId       String
  publicSlug  String   @unique
  /// draft | ready | archived
  status      String   @default("draft")
  /// JSON: ExecPackPayload (all sections)
  payloadJson String
  /// Anonymized version toggle state at generation time
  anonymized  Boolean  @default(false)
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, generatedAt])
  @@map("exec_packs")
}

// ─── System Settings (global KV feature flags) ────────────────────────────────

// Global key/value settings for system-level feature flags.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())

  @@map("app_settings")
}

// ─── V25: Internal Builder Autopilot (InovaCortex-only) ──────────────────────

/// Canonical reusable blueprint for a build type.
model BuildTemplate {
  id            String   @id @default(uuid())
  orgId         String
  /// e.g. "whatsapp_funnel_v1", "clinic_stack_v1"
  key           String
  name          String
  description   String
  version       Int      @default(1)
  /// JSON: canonical blueprint definition (deterministic)
  blueprintJson String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orgId, key, version])
  @@index([orgId, key])
  @@map("build_templates")
}

/// A single execution run of the builder.
model BuildRun {
  id                String   @id @default(uuid())
  orgId             String
  /// optional destination org slug
  targetOrgSlug     String?
  /// optional destination workspace
  targetWorkspaceId String?
  /// plan_only | prompt_pack | code_patch
  mode              String
  /// draft | review | approved | executing | done | failed
  status            String   @default("draft")
  /// JSON: assessment/proposal/workspace snapshot used as input
  inputJson         String
  /// JSON: generated plan / prompt pack summary
  outputJson        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  artifacts BuildArtifact[]

  @@index([orgId, status, createdAt])
  @@map("build_runs")
}

/// An artifact produced by a BuildRun.
model BuildArtifact {
  id         String    @id @default(uuid())
  orgId      String
  buildRunId String
  buildRun   BuildRun  @relation(fields: [buildRunId], references: [id])
  /// implementation_plan | prompt_pack | diff_plan | checklist
  type       String
  version    Int       @default(1)
  body       String
  reviewedAt DateTime?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId, buildRunId, type, version])
  @@map("build_artifacts")
}

// ─── V27: CEO Command Center Real-Time Intelligence ──────────────────────────

/// Event log for the real-time activity stream and KPI engines.
model SystemEvent {
  id             String   @id @default(uuid())
  organizationId String
  type           String // lead_created | whatsapp_inbound | whatsapp_outbound | ...
  severity       String   @default("info") // info | warning | error | critical
  message        String?
  entityType     String?
  entityId       String?
  payloadJson    String   @default("{}") // JSON payload 
  dedupeKey      String?  @unique // V41 idempotency
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@map("system_events")
}

// ─── V29: AI Business Brain ──────────────────────────────────────────────────

model StrategicInsight {
  id                     String @id @default(uuid())
  organizationId         String
  /// sales | marketing | delivery | revenue | operations
  category               String
  title                  String
  description            String
  /// 1-10 scale denoting the severity or potential ROI of the insight
  impactScore            Int    @default(5)
  estimatedRevenueImpact Int?
  recommendedAction      String

  /// active | acknowledged | resolved
  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, category])
  @@map("strategic_insights")
}

// ─── V28: Autonomous Growth Engine ───────────────────────────────────────────

model GrowthSignal {
  id             String  @id @default(uuid())
  organizationId String
  type           String // proposal_viewed | case_study_viewed | outbound_reply | workspace_completed
  severity       String  @default("medium") // high | medium | low
  message        String
  metadataJson   String? // JSON context
  actionTaken    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([organizationId, type])
  @@map("growth_signals")
}

// ─── V30: Refined Market Intelligence Engine ─────────────────────────────────

model BenchmarkSegment {
  id          String   @id @default(uuid())
  orgCount    Int      @default(0)
  industry    String
  sizeBand    String // e.g., "small", "medium", "enterprise"
  plan        String // "free", "growth", "enterprise"
  timeWindow  String // "7d" | "30d" | "90d"
  periodStart DateTime
  periodEnd   DateTime

  snapshots BenchmarkSnapshot[]

  @@index([industry, sizeBand, plan, timeWindow, periodEnd])
  @@map("benchmark_segments")
}

model BenchmarkSnapshot {
  id        String           @id @default(uuid())
  segmentId String
  segment   BenchmarkSegment @relation(fields: [segmentId], references: [id])

  /// JSON: aggregate metrics (proposalAcceptanceRate, meetingShowRate, etc.)
  metrics String

  createdAt DateTime @default(now())

  // One snapshot per segment (which already embodies the period and cohort)
  @@unique([segmentId])
  @@map("benchmark_snapshots")
}

// ─── V31: AI Control Room (Hybrid Chat) ──────────────────────────────────────



model AIChatSession {
  id              String  @id @default(uuid())
  organizationId  String
  createdByUserId String?

  scope String @default("admin")
  title String

  messages AIChatMessage[]

  createdAt    DateTime       @default(now())
  RetrievalLog RetrievalLog[]

  @@index([organizationId])
  @@map("ai_chat_sessions")
}

model AIChatMessage {
  id        String        @id @default(uuid())
  sessionId String
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  organizationId String

  role    String
  content String    

  command String? // se veio de /command
  meta    String? // tokens, cachedHit, sources — stored as JSON string

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([organizationId])
  @@map("ai_chat_messages")
}

model AIChatMemoryItem {
  id             String @id @default(uuid())
  organizationId String

  type    String
  text    String          
  summary String?          // Sumarização para contextos rápidos

  sourceRef       String? // e.g. proposalId, meetingId
  evidenceIdsJson String? // Referências a KnowledgeDocuments ou SystemEvents — stored as JSON string
  confidence      Int     @default(5) // 1-10

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([organizationId, type])
  @@map("ai_chat_memory_items")
}

model KnowledgeDocument {
  id             String @id @default(uuid())
  organizationId String

  /// assessment | proposal | meeting | whatsapp | sales_note | system_event | playbook
  sourceType String
  sourceId   String?

  title        String
  rawText      String
  metadataJson String? // JSON string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, sourceType])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String            @id @default(uuid())
  organizationId String
  documentId     String
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int
  chunkText  String
  chunkHash  String @default("")
  embedding  String? // Vector store representation (Lite) — stored as JSON string
  tokenCount Int    @default(0)

  createdAt DateTime @default(now())

  @@index([organizationId, documentId])
  @@map("knowledge_chunks")
}

model RetrievalLog {
  id             String         @id @default(uuid())
  organizationId String
  sessionId      String?
  session        AIChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  queryText   String
  topK        Int    @default(5)
  resultsJson String? // Array of { documentId, chunkId, score } — stored as JSON string

  createdAt DateTime @default(now())

  @@index([organizationId, sessionId])
  @@map("retrieval_logs")
}

// ─── V34: WhatsApp RBAC ─────────────────────────────────────────────────────

/// Authorized WhatsApp users with role-based access to the AI Copilot.
model WhatsAppUser {
  id          String   @id @default(uuid())

  /// E.164 phone number (e.g. "5511999998888")
  phoneNumber String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// ceo   — full access: executive data, all commands
  /// admin — full access: all commands
  /// sales — restricted: only own leads, no executive data
  role String @default("sales") // ceo | admin | sales

  /// Optional: link to a platform User account
  userId String?

  /// Display name for logs and alerts
  name String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One phone per org
  @@unique([phoneNumber, organizationId])
  @@index([organizationId])
  @@map("whatsapp_users")
}

// ─── V35: Sales Team OS ──────────────────────────────────────────────────────

/// Sales representative (SDR, Closer, or Customer Success)
model SalesRep {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Optional link to platform user account
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])

  name           String
  phone          String?
  email          String?

  /// SDR | Closer | CS
  role           String   @default("SDR")

  active         Boolean  @default(true)

  assignments    LeadAssignment[]
  salesAssignments SalesAssignment[]
  performanceSnapshots PerformanceSnapshot[]
  targets        SalesTarget[]
  payouts        CommissionPayout[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@map("sales_reps")
}

/// Assignment of a lead (Assessment) to a SalesRep
model LeadAssignment {
  id               String   @id @default(uuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  salesRepId       String
  salesRep         SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  /// User who made the assignment (null = auto-assigned)
  assignedByUserId String?
  assignedBy       User?    @relation(fields: [assignedByUserId], references: [id])

  /// active | reassigned | closed
  status           String   @default("active")

  assignedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([salesRepId])
  @@index([assessmentId])
  @@map("lead_assignments")
}

/// Monthly revenue target for a SalesRep
model SalesTarget {
  id         String   @id @default(uuid())
  salesRepId String
  salesRep   SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  /// "YYYY-MM" format, e.g. "2026-03"
  month      String
  targetCents Int     @default(0)

  createdAt  DateTime @default(now())

  @@unique([salesRepId, month])
  @@map("sales_targets")
}

/// Commission rule for the organization
model CommissionRule {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// fixed | percent
  type           String   @default("percent")

  /// cents (fixed) or basis points x 100 (percent: 1000 = 10%)
  value          Int

  /// proposal | payment
  appliesTo      String   @default("payment")

  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  payouts        CommissionPayout[]

  @@index([organizationId])
  @@map("commission_rules")
}

/// Individual commission payout per deal
model CommissionPayout {
  id               String   @id @default(uuid())
  salesRepId       String
  salesRep         SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)

  commissionRuleId String?
  rule             CommissionRule? @relation(fields: [commissionRuleId], references: [id])

  /// Link to the billing record or proposal
  billingRecordId  String?

  amountCents      Int

  /// pending | paid | cancelled
  status           String   @default("pending")

  paidAt           DateTime?
  createdAt        DateTime @default(now())

  @@index([salesRepId, status])
  @@map("commission_payouts")
}

// ─── V36 WhatsApp CRM OS Models (SQLite fallback) ─────────────────────────

model Contact {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  phoneNumberE164 String
  wa_id           String?
  name            String?
  tags            String       @default("[]")
  lifecycle       String       @default("lead")
  lastMessageAt   DateTime?
  
  // Session / Compliance fields
  lastInboundAt      DateTime?
  lastOutboundAt     DateTime?
  sessionWindowUntil DateTime?
  optedOutAt         DateTime?
  optOutReason       String?
  
  optIn           WhatsAppOptIn?
  conversations   WhatsAppConversation[]
  campaignSends   WhatsAppCampaignSend[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, phoneNumberE164])
  @@map("contacts")
}

model WhatsAppConversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  
  assignedUserId String?
  user           User?        @relation(fields: [assignedUserId], references: [id])
  
  status         String       @default("open")
  slaDueAt       DateTime?
  
  // Inbox performance fields
  lastMessageAt       DateTime?
  lastMessagePreview  String?
  unreadCount         Int         @default(0)
  
  messages       WhatsAppMessage[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, contactId])
  @@index([organizationId, status, slaDueAt])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  messageId      String?              @unique
  direction      String
  type           String               @default("text")
  text           String?
  mediaUrl       String?
  status         String               @default("sent")
  replyToId      String?
  errorJson      String?
  
  // Delivery timestamps & metadata payload
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  metaStatusPayload String?

  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppOptIn {
  id             String   @id @default(uuid())
  contactId      String   @unique
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  source         String
  consentAt      DateTime @default(now())
  proofJson      String?

  @@index([contactId])
  @@map("whatsapp_opt_ins")
}

model WhatsAppTemplate {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  language       String         @default("pt_BR")
  status         String         @default("pending")
  bodyJson       String
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  campaigns      WhatsAppCampaign[]

  @@unique([organizationId, name, language])
  @@map("whatsapp_templates")
}

model WhatsAppCampaign {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       WhatsAppTemplate @relation(fields: [templateId], references: [id])
  
  name           String
  segmentQuery   String
  scheduleAt     DateTime?
  throttlePolicy String
  stats          String           @default("{}")
  
  status         String           @default("draft")
  
  sends          WhatsAppCampaignSend[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, status])
  @@map("whatsapp_campaigns")
}

model WhatsAppCampaignSend {
  id             String           @id @default(uuid())
  campaignId     String
  campaign       WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id])
  
  status         String           @default("pending")
  errorCode      String?
  sentAt         DateTime?

  @@unique([campaignId, contactId])
  @@map("whatsapp_campaign_sends")
}

model StrategyRecommendation {
  id             String   @id @default(uuid())
  organizationId String
  type           String   // growth | revenue | churn | delivery | outbound
  title          String
  summary        String
  evidenceJson   String   // list of evidence refs {sourceType, sourceId, metricKey}
  impactScore    Int      // 1-10
  effortScore    Int      // 1-10
  roiCents       Int?
  status         String   @default("active") // active | dismissed | executed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([organizationId, status, impactScore])
  @@map("strategy_recommendations")
}

model ExperimentPlan {
  id             String   @id @default(uuid())
  organizationId String
  hypothesis      String
  metricKey       String  // proposalAcceptance | replyRate | showRate | pipelineVelocity
  baselineValue   Float?
  targetValue     Float?
  planJson        String  // steps, variants, timeline, owner
  status          String  @default("draft") // draft | running | done
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([organizationId, status])
  @@map("experiment_plans")
}

// ─── V38: Offer Engine (High-Ticket) ──────────────────────────────────────────

model Offer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  niche          String?
  status         String   @default("draft") // draft | published | archived
  priceCents     Int
  currency       String   @default("BRL")
  
  /// JSON: promise, deliverables, timeline, guarantees, exclusions
  offerJson      String   
  
  /// JSON: variables + defaults
  roiModelJson   String   
  
  publishedSlug  String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets         OfferAsset[]

  @@index([organizationId, status])
  @@map("offers")
}

model OfferAsset {
  id             String   @id @default(uuid())
  offerId        String
  offer          Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  
  /// one_pager_html | proposal_template | contract_template | checkout_config
  type           String   
  content        String
  
  createdAt      DateTime @default(now())

  @@index([offerId, type])
  @@map("offer_assets")
}

// ─── V39: Performance Intelligence OS ───────────────────────────────────────

model SalesAssignment {
  id             String @id @default(uuid())
  organizationId String
  salesRepId     String
  salesRep       SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  entityType     String // lead | proposal | conversation
  entityId       String
  createdAt      DateTime @default(now())

  @@unique([organizationId, entityType, entityId])
  @@map("sales_assignments")
}

model PerformanceSnapshot {
  id             String @id @default(uuid())
  organizationId String
  salesRepId     String?
  salesRep       SalesRep? @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  window         String @default("7d") // 7d | 30d
  
  /// JSON: replyTimeAvg, meetings, showRate, proposalsSent, wins, revenueCents
  statsJson      String   
  
  createdAt      DateTime @default(now())

  @@index([organizationId, window])
  @@map("performance_snapshots")
}

// ─── V41: Autonomous Execution Engine (Playbooks) ─────────────────────────────

model Playbook {
  id             String @id @default(uuid())
  organizationId String
  name           String
  description    String
  status         String @default("draft") // draft | active | paused
  trigger        String @default("manual") // manual | scheduled | event
  approvalMode   String @default("requires_admin") // auto | requires_owner | requires_admin
  policyJson     String // JSON limits, cooldowns, allowed channels, safe hours
  stepsJson      String // JSON deterministic step list
  tags           String // JSON string array of tags
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runs           PlaybookRun[]

  @@index([organizationId, status])
  @@map("playbooks")
}

model PlaybookRun {
  id               String @id @default(uuid())
  playbookId       String
  playbook         Playbook @relation(fields: [playbookId], references: [id])
  organizationId   String
  status           String @default("queued") // queued | running | success | failed | canceled
  actorUserId      String?
  dryRun           Boolean @default(false)
  inputJson        String? // JSON input arguments
  resultJson       String? // JSON execution results
  errorJson        String? // JSON error details
  approvedByUserId String?
  approvedAt       DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([organizationId, status, createdAt])
  @@map("playbook_runs")
}

model PlaybookApproval {
  id                String @id @default(uuid())
  organizationId    String
  playbookRunId     String @unique
  requestedByUserId String?
  requiredRole      String // admin, owner
  status            String @default("pending") // pending | approved | rejected
  note              String?
  createdAt         DateTime @default(now())
  decidedAt         DateTime?

  @@index([organizationId, status])
  @@map("playbook_approvals")
}
